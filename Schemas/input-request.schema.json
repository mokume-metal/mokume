{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mokume.org/schemas/input-request.schema.json",
  "title": "入力の要求",
  "description": "走っているスケッチへ入力の出来事を送る。1 回にいくつでも並べられる (ドラッグのような連なりもそのまま送れる)。ADR-0018 決定 3 のとおり原子的に置き、id は要求ごとに変える。",
  "type": "object",
  "required": [
    "id",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "この要求の識別子。応答はこれを echo する。"
    },
    "events": {
      "type": "array",
      "description": "送る出来事。並んだ順に流し込まれる。**知らない種別は、その 1 件だけが捨てられる** (残りは通る)。",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "知らない鍵は無視される。**意味を持つ既定値が無いフィールドは種別ごとに必須**で、欠けた 1 件は解けなかったものとして ignored に数えられる (残りは通る)。位置には x / y、キーには code が要る — 0 は面の左上であり A のキーであって「無い」ではないため。button (0 = 主釦) / dx / dy (0 = 動かない) / characters (空) / isRepeat (false) は省略が自然に読めるので任意。",
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "mouseDown",
                    "mouseUp",
                    "mouseMoved"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "x",
                "y"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "keyDown",
                    "keyUp"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "code"
              ]
            }
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "mouseDown",
              "mouseUp",
              "mouseMoved",
              "scrolled",
              "keyDown",
              "keyUp"
            ]
          },
          "x": {
            "type": "number",
            "description": "キャンバスの座標 (横)。窓の座標からの変換は送り手の責務。"
          },
          "y": {
            "type": "number",
            "description": "キャンバスの座標 (縦)。"
          },
          "button": {
            "type": "integer",
            "description": "釦 (0 = 主釦)。"
          },
          "dx": {
            "type": "number",
            "description": "スクロールされた量 (横)。**その 1 件ぶん**で、スケッチの mouseWheel(deltaX:deltaY:) にこの値がそのまま渡る。"
          },
          "dy": {
            "type": "number",
            "description": "スクロールされた量 (縦)。dx と同じく 1 件ぶん。"
          },
          "code": {
            "type": "integer",
            "description": "キーの符号。**macOS の仮想キーコード** (49 = Space・0 = A・126 = ↑) で、ブラウザや Java の符号とは体系が違う。スケッチの面ではこの数が `Key` の綴り (`.space` など) として読める。"
          },
          "characters": {
            "type": "string"
          },
          "isRepeat": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
