# 生成物とローカル環境の秘密を git から締め出す (ADR-0001 原則 7)。
# 実際に踏んだ必要のあるものだけを書く — 使っていないツールの分は先回りしない。

# SwiftPM
.build/
.swiftpm/
Packages/

# Xcode
xcuserdata/
DerivedData/

# macOS
.DS_Store

# Python (scripts/tests のフック検査が置いていく)
__pycache__/

# 秘密情報 (実データ・API キーの置き場。コミットしない)
.env
.env.*

# 参照スケッチの絵。撮った絵は Gyazo へ上げて URL で参照する (リポジトリへ置かない)
shots/

# 外とやりとりする区画。証跡を撮らなくても、つまみを持つスケッチを走らせるだけで生える
# (値の保存は区画の有無と関係なく効く)。追跡外のまま残ると作業ツリーが汚れて見え、
# 描画 PR が merge できなくなったことがある (#724。当時の手元の実行の報告は #879 で畳んだ)。綴りは雛形 (mokume new が
# 置く gitignore.template) に合わせる
.mokume/

# 道具に同梱する作例の束。説明文から scripts/bundle-examples.py が作る生成物 (make cli-examples・
# make cli-dist)。置き場を実在させる README の 1 枚だけは `git add -f` で追跡している。置き場ごと
# 無視するのは、reuse lint が否定パターンを通した無視 (`!README.md`) を拾わず、束の 1 本ずつを
# 帰属不明と読むため
Sources/MokumeCLI/Examples/
