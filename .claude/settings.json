{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make ci-check:*)",
      "Bash(make setup:*)",
      "Bash(make check:*)",
      "Bash(bash scripts/check-no-binaries.sh:*)",
      "Bash(make hooks-test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "env": {
    "CLAUDE_PLAN_RECORD": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-comment-guard.sh\"",
            "timeout": 10,
            "statusMessage": "コメントの投稿経路を確認中"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/pr-identity-guard.sh\"",
            "timeout": 10,
            "statusMessage": "PR の作成主体を確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/plan-record.sh\" capture",
            "timeout": 20,
            "statusMessage": "プランを GitHub 用に整えています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/plan-record.sh\" guard",
            "timeout": 30,
            "statusMessage": "プランが GitHub に残ったか確認中"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "shinyaoguri": {
      "source": {
        "source": "github",
        "repo": "shinyaoguri/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "repo-standards@shinyaoguri": true
  }
}
